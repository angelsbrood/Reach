+import Foundation
+import XCTest
+import MLX
+import MLXNN
+@testable import MLXLMCommon
+@_spi(ResumableGuidedFixtures) @testable import MLXGuidedGeneration
+
+struct S74ByteTokenizer: Tokenizer {
+    static let vocab = ["<eos>"] + (0...255).map { String(format: "<0x%02X>", $0) } + ["<unk>"]
+    func encode(text: String, addSpecialTokens: Bool) -> [Int] { text.utf8.map { Int($0) + 1 } }
+    func decode(tokenIds: [Int], skipSpecialTokens: Bool) -> String {
+        String(decoding: tokenIds.filter { (1...256).contains($0) }.map { UInt8($0 - 1) }, as: UTF8.self)
+    }
+    func convertTokenToId(_ token: String) -> Int? { Self.vocab.firstIndex(of: token) }
+    func convertIdToToken(_ id: Int) -> String? { Self.vocab.indices.contains(id) ? Self.vocab[id] : nil }
+    var bosToken: String? { nil }
+    var eosToken: String? { "<eos>" }
+    var unknownToken: String? { "<unk>" }
+    func applyChatTemplate(messages: [[String: any Sendable]], tools: [[String: any Sendable]]?,
+                           additionalContext: [String: any Sendable]?) throws -> [Int] { [] }
+}
+
+struct GuidedFixtureState { var position: Int; var running: MLXArray }
+let guidedFixtureKey=LMOutput.Key<GuidedFixtureState>("s74.position-running")
+func guidedCodecs() throws -> ResumableStateCodecs {
+    var codecs=ResumableStateCodecs()
+    try codecs.register(guidedFixtureKey,type:"native-recurrence-v1",schema:1,encode:{
+        .init(metadata:try JSONEncoder().encode($0.position),tensors:[try .init(capturing:$0.running)])
+    },decode:{
+        let position=try JSONDecoder().decode(Int.self,from:$0.metadata)
+        guard (0...131_072).contains(position), $0.tensors.count==1,
+            $0.tensors[0].shape==[2], $0.tensors[0].dtype=="float32" else { throw ResumableTokenError.invalid("fixture state") }
+        return try .init(position:position,running:$0.tensors[0].restored())
+    })
+    return codecs
+}
+final class GuidedFixtureModel: Module, LanguageModel {
+    let program: [Int]
+    let width: Int
+    let preferPadding: Bool
+    var inputs: [[Int]]=[]
+    var priorOffsets: [Int]=[]
+    var positions: [Int]=[]
+    init(program: [Int], width: Int = 258, preferPadding: Bool = false) {
+        self.program=program; self.width=width; self.preferPadding=preferPadding; super.init()
+    }
+    func newCache(parameters: GenerateParameters?) -> [KVCache] { [KVCacheSimple()] }
+    func prepare(_ input: LMInput, cache: [KVCache], state: LMOutput.State?, windowSize: Int?) throws -> PrepareResult {
+        throw ResumableTokenError.unsupported("generic prepare must not be called")
+    }
+    func callAsFunction(_ input: LMInput.Text, cache: [KVCache]?, state: LMOutput.State?) -> LMOutput {
+        let tokens=input.tokens.asArray(Int.self)
+        inputs.append(tokens); priorOffsets.append(cache![0].offset)
+        let previous=state?[guidedFixtureKey]
+        var running=previous?.running ?? MLXArray([Float(0),1])
+        for token in tokens { running=running*0.5+Float(token) }
+        let position=(previous?.position ?? 0)+tokens.count; positions.append(position)
+        let values=broadcast(input.tokens.asType(.float32).reshaped(1,1,-1,1),to:[1,1,tokens.count,2])
+        let pair=cache![0].update(keys:values,values:values*0.25)
+        let shift=pair.0.sum()*0.00001+running.sum()*0.0001
+        let target=program[min(max(0,position-5),program.count-1)]
+        let ids=MLXArray.arange(width)
+        var row=MLX.where(ids .== target, MLXArray(Float(100))+shift, MLXArray(Float(-100))+sin(ids.asType(.float32)))
+        if preferPadding && width>258 { row=MLX.where(ids .>= 258, MLXArray(Float(1000)), row) }
+        var next=LMOutput.State(); next[guidedFixtureKey] = .init(position:position,running:running)
+        return .init(logits:broadcast(row.reshaped(1,1,width),to:[1,tokens.count,width]),state:next)
+    }
+}
+struct GuidedSetup {
+    let model: GuidedFixtureModel
+    let identity: ResumableTokenIdentity
+    var specification: ResumableGrammarSpecification
+    var options: ResumableGuidedOptions
+    var specs: [ResumableCacheSpec]
+    let prompt=[1,2,3,4,5]
+    init(literal: Bool = false, maximum: Int = 12, rotating: Bool = false, width: Int = 258,
+         program: [Int]? = nil, preferPadding: Bool = false) throws {
+        let program=program ?? (S74ByteTokenizer().encode(text:"\"中abc\"")+[0])
+        model=GuidedFixtureModel(program:program,width:width,preferPadding:preferPadding)
+        identity=try .init(model:"s74-native-fixture",configuration:"v1",weights:"fixed-analytic",
+            input:ResumableTokenIdentity.inputDigest([1,2,3,4,5]),backend:"s74-native",dependency:"S72+S73")
+        specification = literal ? .literalFixture("root ::= \"\\\"中abc\\\"\"",vocabulary:S74ByteTokenizer.vocab,vocabularyType:.byteFallback,
+            tokenizerIdentity:"byte-fixture-v1",eosTokenID:0,unknownTokenID:257)
+            : .init(jsonSchema:#"{"type":"string","enum":["中abc"]}"#,vocabulary:S74ByteTokenizer.vocab,vocabularyType:.byteFallback,
+                tokenizerIdentity:"byte-fixture-v1",eosTokenID:0,unknownTokenID:257)
+        options = .init(model:.init(logitWidth:width,maximumTokens:maximum,prefillStepSize:2),completionReserve:0)
+        specs=[.init(kind:rotating ? .rotating : .simple,heads:1,keyDimension:2,valueDimension:2,maxSize:rotating ? 4 : 0,keep:rotating ? 1 : 0)]
+    }
+    func prepare() throws -> ResumableGuidedGeneration {
+        try .prepare(model:model,tokens:prompt,identity:identity,cacheSpecs:specs,codecs:guidedCodecs(),tokenizer:S74ByteTokenizer(),specification:specification,options:options)
+    }
+    func restore(_ checkpoint: ResumableGuidedCheckpoint, model: GuidedFixtureModel? = nil) throws -> ResumableGuidedGeneration {
+        try .restore(checkpoint,model:model ?? self.model,identity:identity,cacheSpecs:specs,codecs:guidedCodecs(),tokenizer:S74ByteTokenizer(),specification:specification,options:options)
+    }
+}
+struct GuidedObserved: Equatable {
+    let token: Int?
+    let origin: ResumableGuidedOrigin?
+    let records: [ResumableGuidedRecord]
+}
+func guidedDrain(_ driver: ResumableGuidedGeneration) throws -> [GuidedObserved] {
+    var result:[GuidedObserved]=[]
+    while let batch=try driver.advance() { result.append(.init(token:batch.token,origin:batch.origin,records:batch.records)) }
+    return result
+}
+func guidedBytes(_ batches: [GuidedObserved]) -> [Data] {
+    batches.flatMap(\.records).compactMap { if case .text(let bytes)=$0 { return bytes }; return nil }
+}
+func assertRecurrence(_ model: GuidedFixtureModel, generated: [Int], file: StaticString = #filePath, line: UInt = #line) {
+    let expected=[[1,2],[3,4],[5]]+generated.map { [$0] }
+    XCTAssertEqual(model.inputs,expected,file:file,line:line)
+    var count=0
+    for (tokens,offset) in zip(expected,model.priorOffsets) {
+        XCTAssertEqual(offset,count,file:file,line:line); count+=tokens.count
+    }
+    XCTAssertEqual(model.positions.last,count,file:file,line:line)
+}
+
+final class ResumableGuidedGenerationTests: XCTestCase {
+    func testAllBoundariesAndIndependentSingleTokenRecurrence() throws {
+        for literal in [false,true] {
+            let setup=try GuidedSetup(literal:literal,rotating:literal)
+            let driver=try setup.prepare(); let c0=try driver.capture()
+            let full=try guidedDrain(driver)
+            XCTAssertEqual(guidedBytes(full),["\"","中","a","b","c","\""].map { Data($0.utf8) })
+            let generated=full.filter { $0.origin != .ending }.compactMap(\.token)
+            XCTAssertEqual(generated,S74ByteTokenizer().encode(text:"\"中abc\""))
+            assertRecurrence(setup.model,generated:generated)
+            let child=try ResumableGuidedModelCheckpoint(data:driver.capture().document().model).document()
+            let actual=try child.state!.first!.payload.tensors[0].restored().asArray(Float.self)
+            var expected:[Float]=[0,1]
+            for token in setup.prompt+generated { expected=expected.map { $0*0.5+Float(token) } }
+            XCTAssertEqual(actual,expected)
+            for cut in 0...9 {
+                let model=GuidedFixtureModel(program:setup.model.program)
+                let producer=try setup.restore(c0,model:model)
+                var prefix:[GuidedObserved]=[]
+                for _ in 0..<cut { if let b=try producer.advance() { prefix.append(.init(token:b.token,origin:b.origin,records:b.records)) } }
+                let saved=try producer.capture(); let bytes=saved.data
+                if literal && cut==2 { XCTAssertGreaterThan(producer.pendingForcedTokens.count,0) }
+                let suffix=try guidedDrain(producer)
+                let fresh=GuidedFixtureModel(program:setup.model.program)
+                let resumed=try setup.restore(.init(data:saved.data),model:fresh)
+                XCTAssertEqual(fresh.inputs,[])
+                XCTAssertEqual(try guidedDrain(resumed),suffix)
+                XCTAssertEqual(prefix+suffix,full); XCTAssertEqual(saved.data,bytes)
+                XCTAssertEqual(try resumed.capture(),try producer.capture())
+                XCTAssertNil(try resumed.advance()); XCTAssertNil(try resumed.cancel())
+                resumed.close(); producer.close()
+            }
+            driver.close()
+        }
+    }
+    func testBudgetPendingSuffixFinalStopZeroCancelAndClose() throws {
+        for maximum in [0,3,8,9] {
+            let setup=try GuidedSetup(literal:true,maximum:maximum)
+            let driver=try setup.prepare()
+            if maximum==0 { XCTAssertTrue(setup.model.inputs.isEmpty) }
+            _=try guidedDrain(driver)
+            XCTAssertEqual(driver.terminalReason,maximum==9 ? .complete : .incomplete)
+            if maximum==3 { XCTAssertGreaterThan(driver.pendingForcedTokens.count,0) }
+            if maximum==8 {
+                let state=try driver.capture().document().guided
+                XCTAssertTrue(state.grammar.mask.allows(0)); XCTAssertFalse(state.grammar.mask.terminated)
+            }
+            let fresh=GuidedFixtureModel(program:setup.model.program)
+            let restored=try setup.restore(driver.capture(),model:fresh)
+            XCTAssertNil(try restored.advance()); XCTAssertNil(try restored.cancel()); XCTAssertTrue(fresh.inputs.isEmpty)
+            restored.close(); driver.close()
+        }
+        let setup=try GuidedSetup(literal:true); let driver=try setup.prepare()
+        _=try driver.advance(); let calls=setup.model.inputs.count
+        XCTAssertFalse(try XCTUnwrap(driver.cancel()).records.isEmpty)
+        XCTAssertEqual(setup.model.inputs.count,calls); XCTAssertNil(try driver.cancel())
+        driver.close(); driver.close(); XCTAssertThrowsError(try driver.capture()); XCTAssertThrowsError(try driver.advance())
+    }
+    func testVocabularyWidthAndPrematureUnknownRefusal() throws {
+        for width in [256,260] {
+            let setup=try GuidedSetup(width:width,preferPadding:true)
+            let driver=try setup.prepare(); _=try guidedDrain(driver)
+            XCTAssertEqual(driver.terminalReason,.complete); driver.close()
+        }
+        var setup=try GuidedSetup(); setup.specification.unknownTokenID=35
+        let driver=try setup.prepare(); let count=setup.model.inputs.count
+        XCTAssertThrowsError(try driver.advance()); XCTAssertTrue(driver.isClosed)
+        XCTAssertEqual(setup.model.inputs.count,count)
+    }
+    func testWhitespaceLatchAndZonePolicy() throws {
+        var setup=try GuidedSetup(program:[92,33,33,33]+S74ByteTokenizer().encode(text:"\"中abc\"")+[94,0])
+        setup.specification.source = #"{"type":"array","items":{"type":"string","enum":["中abc"]},"minItems":1,"maxItems":1}"#
+        setup.specification.fastForward=false
+        var ws=[Float](repeating:0,count:258); ws[33] = -200
+        setup.options.whitespaceBias=ws; setup.options.whitespaceTokenIDs=[33]
+        let driver=try setup.prepare()
+        _=try driver.advance() // opening bracket; the schema permits whitespace inside the array
+        for index in 1...3 {
+            _=try driver.advance()
+            let state=try driver.capture().document().guided
+            XCTAssertEqual(state.whitespaceCount,index); XCTAssertEqual(state.whitespaceLatched,index==3)
+        }
+        _=try driver.advance()
+        let state=try driver.capture().document().guided
+        XCTAssertTrue(state.whitespaceLatched); XCTAssertEqual(state.whitespaceCount,0)
+        let fresh=GuidedFixtureModel(program:setup.model.program)
+        let restored=try setup.restore(driver.capture(),model:fresh)
+        XCTAssertTrue(try restored.capture().document().guided.whitespaceLatched); XCTAssertTrue(fresh.inputs.isEmpty)
+        restored.close(); driver.close()
+        var options=setup.options
+        options.model.maximumTokens=10; options.completionReserve=4; options.hardReserve=2
+        var closing=[Float](repeating:0,count:258); closing[0]=200; closing[35]=100
+        options.closingBias=closing
+        let mask=GuidedMask(.init(mask:[Int32](repeating:-1,count:9),isTerminated:false,needsApply:true))
+        XCTAssertEqual(options.zone(at:5),.normal); XCTAssertEqual(options.zone(at:6),.soft); XCTAssertEqual(options.zone(at:8),.hard)
+        XCTAssertNil(options.bias(at:5,mask:mask,whitespaceActive:false,eos:0))
+        XCTAssertEqual(options.bias(at:6,mask:mask,whitespaceActive:false,eos:0)!.asArray(Float.self)[0],200)
+        let hard=options.bias(at:8,mask:mask,whitespaceActive:true,eos:0)!.asArray(Float.self)
+        XCTAssertEqual(hard[0],-10_000); XCTAssertEqual(hard[35],0); XCTAssertEqual(hard[33],-10_200)
+        var literal=try GuidedSetup(literal:true)
+        literal.specification.source="root ::= \"\\\"   abc\\\"\""
+        literal.options.whitespaceBias=ws; literal.options.whitespaceTokenIDs=[33]
+        let forced=try literal.prepare()
+        _=try forced.advance()
+        XCTAssertEqual(try forced.advance()?.origin,.forced)
+        XCTAssertEqual(try forced.capture().document().guided.whitespaceCount,0)
+        XCTAssertFalse(try forced.capture().document().guided.whitespaceLatched)
+        forced.close()
+    }
+}
