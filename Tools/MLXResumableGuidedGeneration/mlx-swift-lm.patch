+import Foundation
+import XCTest
+import MLXLMCommon
+@testable import MLXGuidedGeneration
+
+final class ResumableGuidedCheckpointTests: XCTestCase {
+    func testConsumedHistoryRejectsUnreachableOutputWithoutModelWork() throws {
+        for literal in [false,true] {
+            let setup=try GuidedSetup(literal:literal)
+            let live=try setup.prepare()
+            for _ in 0..<3 { _=try live.advance() }
+            let saved=try live.capture(); let document=try saved.document()
+            XCTAssertEqual(document.guided.grammar.accepts.prefix(3).map(\.token),[35,229,185])
+            XCTAssertEqual(document.guided.text.value.tokens,[35,229,185])
+            XCTAssertEqual(document.guided.text.value.emitted,Data("\"".utf8))
+            XCTAssertEqual(document.guided.text.value.emittedTokenCount,1)
+            let calls=setup.model.inputs.count
+            // Exact reported cut-3 value, a longer suffix, and the complete
+            // segment with an impossible emitted position all pass the old
+            // internal text check and last-token check. None is reachable.
+            for tokens in [[185],[229,185],[35,229,185]] {
+                var altered=document
+                altered.guided.text.value.tokens=tokens
+                altered.guided.text.value.emitted=Data()
+                altered.guided.text.value.emittedTokenCount=0
+                try altered.guided.text.value.validate(tokenizer:S74ByteTokenizer(),generated:3,vocabulary:258)
+                let malformed=try ResumableGuidedCheckpoint(document:altered)
+                let fresh=GuidedFixtureModel(program:setup.model.program)
+                XCTAssertThrowsError(try setup.restore(malformed,model:fresh))
+                XCTAssertTrue(fresh.inputs.isEmpty)
+                XCTAssertEqual(try live.capture(),saved)
+                XCTAssertEqual(setup.model.inputs.count,calls)
+            }
+            let independent=try setup.restore(saved,model:GuidedFixtureModel(program:setup.model.program))
+            XCTAssertEqual(try guidedDrain(independent),try guidedDrain(live))
+            XCTAssertEqual(live.terminalReason,.complete)
+            independent.close(); live.close()
+        }
+    }
+    func testRefusalAndIndependentLiveOperation() throws {
+        let setup=try GuidedSetup(literal:true)
+        let live=try setup.prepare(); _=try live.advance(); _=try live.advance()
+        let saved=try live.capture(); let d=try saved.document(); let calls=setup.model.inputs.count
+        let changes: [(inout ResumableGuidedDocument)->Void]=[
+            { $0.guided.consumed+=1 }, { $0.guided.sampled+=1 }, { $0.guided.forced+=1 },
+            { $0.guided.promptCount+=1 }, { $0.guided.whitespaceLatched=true },
+            { $0.guided.terminal = .complete }, { $0.guided.terminal = .incomplete },
+            { $0.guided.grammar.accepts[$0.guided.consumed].origin = .sampled },
+            { $0.guided.grammar.accepts[0].token=0 }, { $0.guided.text.value.emitted=Data("wrong".utf8) },
+            { $0.guided.specification.tokenizerIdentity="changed" }, { $0.guided.options.sampling="stochastic" },
+            { $0.guided.options.hardReserve+=1 }, { $0.guided.modelDigest="wrong" },
+        ]
+        for change in changes {
+            var altered=d; change(&altered)
+            let fresh=GuidedFixtureModel(program:setup.model.program)
+            XCTAssertThrowsError(try setup.restore(.init(document:altered),model:fresh))
+            XCTAssertTrue(fresh.inputs.isEmpty); XCTAssertEqual(try live.capture(),saved)
+        }
+        XCTAssertEqual(setup.model.inputs.count,calls)
+        let independent=try setup.restore(saved,model:GuidedFixtureModel(program:setup.model.program))
+        XCTAssertEqual(try guidedDrain(independent),try guidedDrain(live))
+        independent.close(); live.close()
+    }
+    func testEncodingSchemaCorruptionAndSizeBounds() throws {
+        let setup=try GuidedSetup(); let live=try setup.prepare(); let saved=try live.capture()
+        var document=try saved.document(); document.version=2
+        XCTAssertThrowsError(try ResumableGuidedCheckpoint(data:ResumableGuidedCheckpoint(document:document).data))
+        document=try saved.document(); document.prerequisiteIdentity="old"
+        XCTAssertThrowsError(try ResumableGuidedCheckpoint(data:ResumableGuidedCheckpoint(document:document).data))
+        XCTAssertThrowsError(try ResumableGuidedCheckpoint(data:saved.data.dropLast()))
+        var corrupt=saved.data; corrupt[corrupt.count/2]^=1
+        XCTAssertThrowsError(try ResumableGuidedCheckpoint(data:corrupt))
+        XCTAssertThrowsError(try ResumableGuidedCheckpoint(data:Data(count:ResumableGuidedCheckpoint.maximumBytes+1)))
+        document=try saved.document(); document.model=Data(count:8*1024*1024+1)
+        XCTAssertThrowsError(try ResumableGuidedCheckpoint(document:document))
+        document=try saved.document(); document.guided.text.value.emitted=Data(count:1024*1024)
+        XCTAssertThrowsError(try ResumableGuidedCheckpoint(document:document))
+        live.close()
+    }
+    func testModelJoinMismatchAndBoundedDeclarations() throws {
+        let setup=try GuidedSetup(); let live=try setup.prepare(); let c0=try live.capture()
+        _=try live.advance(); var later=try live.capture().document()
+        later.model=try c0.document().model; later.guided.modelDigest=ResumableGuidedValues.digest(later.model)
+        let fresh=GuidedFixtureModel(program:setup.model.program)
+        XCTAssertThrowsError(try setup.restore(.init(document:later),model:fresh)); XCTAssertTrue(fresh.inputs.isEmpty)
+        var invalid=setup
+        invalid.specification.source=String(repeating:"x",count:65_537)
+        XCTAssertThrowsError(try invalid.prepare())
+        invalid=setup; invalid.specification.vocabulary=Array(repeating:"x",count:4097)
+        XCTAssertThrowsError(try invalid.prepare())
+        invalid=setup; invalid.options.closingBias=[Float.infinity]
+        XCTAssertThrowsError(try invalid.prepare())
+        live.close()
+    }
+}
