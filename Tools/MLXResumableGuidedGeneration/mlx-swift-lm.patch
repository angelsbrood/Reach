+import Foundation
+import XCTest
+import MLXLMCommon
+@testable import MLXGuidedGeneration
+
+final class ResumableGrammarStateTests: XCTestCase {
+    func testNativeJSONAndLiteralForcedReplayAtAllFrontiers() throws {
+        for literal in [false,true] {
+            let setup=try GuidedSetup(literal:literal)
+            let owner=try ResumableGrammarState(specification:setup.specification,tokenizer:S74ByteTokenizer())
+            let c0=owner.record
+            XCTAssertFalse(c0.mask.allows(0))
+            XCTAssertThrowsError(try owner.accept(0))
+            let restoredZero=try ResumableGrammarState.restore(c0,specification:setup.specification,tokenizer:S74ByteTokenizer())
+            XCTAssertEqual(restoredZero.record.mask,c0.mask)
+            try owner.accept(35)
+            if literal {
+                XCTAssertEqual(owner.record.accepts.dropFirst().map(\.token),S74ByteTokenizer().encode(text:"中abc"))
+                XCTAssertEqual(owner.record.accepts.count,7)
+            }
+            let restored=try ResumableGrammarState.restore(owner.record,specification:setup.specification,tokenizer:S74ByteTokenizer())
+            XCTAssertEqual(restored.record.accepts,owner.record.accepts)
+            let expected=S74ByteTokenizer().encode(text:"\"中abc\"")
+            while owner.record.accepts.count<expected.count {
+                let token=expected[owner.record.accepts.count]
+                try owner.accept(token); try restored.accept(token)
+                XCTAssertEqual(restored.record.mask,owner.record.mask)
+                XCTAssertEqual(restored.record.accepts,owner.record.accepts)
+            }
+            XCTAssertTrue(owner.record.mask.allows(0)); XCTAssertFalse(owner.record.mask.terminated)
+            try owner.accept(0); try restored.accept(0)
+            XCTAssertTrue(owner.record.mask.terminated)
+            XCTAssertEqual(restored.record.accepts,owner.record.accepts)
+            let terminal=try ResumableGrammarState.restore(owner.record,specification:setup.specification,tokenizer:S74ByteTokenizer())
+            XCTAssertTrue(terminal.record.mask.terminated); XCTAssertThrowsError(try terminal.accept(0))
+        }
+    }
+    func testInvalidReorderedAndIncompatibleMatcherStateRefuses() throws {
+        let setup=try GuidedSetup(literal:true)
+        let owner=try ResumableGrammarState(specification:setup.specification,tokenizer:S74ByteTokenizer())
+        try owner.accept(35)
+        for change in [
+            { (r: inout ResumableGrammarRecord) in r.accepts.swapAt(0,1) },
+            { (r: inout ResumableGrammarRecord) in r.accepts[0].token=Int.max },
+            { (r: inout ResumableGrammarRecord) in r.accepts[0].origin = .forced },
+            { (r: inout ResumableGrammarRecord) in r.mask.terminated=true },
+            { (r: inout ResumableGrammarRecord) in r.mask.needsApply.toggle() },
+        ] {
+            var record=owner.record; change(&record)
+            XCTAssertThrowsError(try ResumableGrammarState.restore(record,specification:setup.specification,tokenizer:S74ByteTokenizer()))
+        }
+        var different=setup.specification; different.source="root ::= \"x\""
+        XCTAssertThrowsError(try ResumableGrammarState.restore(owner.record,specification:different,tokenizer:S74ByteTokenizer()))
+        XCTAssertEqual(owner.record.accepts.count,7)
+    }
+}
