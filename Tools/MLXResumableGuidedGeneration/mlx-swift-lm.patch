@@ -0,0 +1,76 @@
+import Foundation
+import XCTest
+import MLXLMCommon
+@testable import MLXGuidedGeneration
+
+struct NonlinearGuidedTokenizer: Tokenizer {
+    let huge: Bool
+    func encode(text:String,addSpecialTokens:Bool)->[Int] { S74ByteTokenizer().encode(text:text) }
+    func decode(tokenIds:[Int],skipSpecialTokens:Bool)->String {
+        if huge { return String(repeating:"x",count:256*1024+1) }
+        return S74ByteTokenizer().decode(tokenIds:tokenIds).replacingOccurrences(of:"  ,",with:" ,")
+    }
+    func convertTokenToId(_ token:String)->Int? { S74ByteTokenizer().convertTokenToId(token) }
+    func convertIdToToken(_ id:Int)->String? { S74ByteTokenizer().convertIdToToken(id) }
+    var bosToken:String? { nil }; var eosToken:String? { "<eos>" }; var unknownToken:String? { "<unk>" }
+    func applyChatTemplate(messages:[[String:any Sendable]],tools:[[String:any Sendable]]?,additionalContext:[String:any Sendable]?) throws->[Int] { [] }
+}
+final class ResumableGuidedTextStateTests: XCTestCase {
+    func testGuidedRestoreAfterNewlineResetAndNonlinearDecode() throws {
+        let tokenizer=NonlinearGuidedTokenizer(huge:false)
+        let program=tokenizer.encode(text:"[\n0  ,1]")+[0]
+        for cut in [2,6] {
+            var setup=try GuidedSetup(program:program)
+            setup.specification.source = #"{"type":"array","items":{"type":"integer"},"minItems":2,"maxItems":2}"#
+            setup.specification.tokenizerIdentity="nonlinear-byte-v1"
+            setup.specification.fastForward=false
+            let live=try ResumableGuidedGeneration.prepare(model:setup.model,tokens:setup.prompt,identity:setup.identity,
+                cacheSpecs:setup.specs,codecs:guidedCodecs(),tokenizer:tokenizer,specification:setup.specification,options:setup.options)
+            var prefix:[GuidedObserved]=[]
+            for _ in 0..<cut {
+                let batch=try XCTUnwrap(live.advance())
+                prefix.append(.init(token:batch.token,origin:batch.origin,records:batch.records))
+            }
+            let saved=try live.capture(); let text=try saved.document().guided.text.value
+            // The opening bracket was dropped at the newline reset. After
+            // the comma, nonlinear decode has collapsed an earlier space.
+            XCTAssertEqual(text.tokens,Array(program[1..<cut]))
+            XCTAssertEqual(text.emittedTokenCount,cut-1)
+            XCTAssertEqual(text.emitted,Data((cut==2 ? "\n" : "\n0 ,").utf8))
+            let fresh=GuidedFixtureModel(program:program)
+            let resumed=try ResumableGuidedGeneration.restore(saved,model:fresh,identity:setup.identity,
+                cacheSpecs:setup.specs,codecs:guidedCodecs(),tokenizer:tokenizer,specification:setup.specification,options:setup.options)
+            XCTAssertTrue(fresh.inputs.isEmpty); XCTAssertEqual(try resumed.capture(),saved)
+            let expected=try guidedDrain(live)
+            XCTAssertEqual(try guidedDrain(resumed),expected)
+            XCTAssertEqual(try resumed.capture(),try live.capture())
+            XCTAssertEqual(guidedBytes(prefix+expected),["[","\n","0"," "," ",",","1","]"].map { Data($0.utf8) })
+            XCTAssertEqual(resumed.terminalReason,.complete)
+            resumed.close(); live.close()
+        }
+    }
+    func testSplitUnicodeAndNewlineCurrentSegmentRestore() throws {
+        let tokenizer=NonlinearGuidedTokenizer(huge:false)
+        let tokens=tokenizer.encode(text:"中\n  ,")
+        var state=ResumableGuidedTextState(); var records:[ResumableGuidedRecord]=[]
+        for (index,token) in tokens.enumerated() {
+            let bytes=try state.append(token,tokenizer:tokenizer); records+=bytes
+            if index<2 { XCTAssertTrue(bytes.isEmpty) }
+            let encoded=try ResumableGuidedValues.encoder().encode(state)
+            let restored=try JSONDecoder().decode(ResumableGuidedTextState.self,from:encoded)
+            try restored.value.validate(tokenizer:tokenizer,generated:index+1,vocabulary:258)
+            XCTAssertEqual(restored.value,state.value)
+        }
+        let bytes=records.compactMap { if case .text(let b)=$0 { return b }; return nil }
+        XCTAssertEqual(bytes,["中","\n"," "," ",","].map { Data($0.utf8) })
+    }
+    func testInvalidUTF8UnsettledAndOversizedDecodeRefuse() throws {
+        var value=ResumableGuidedTextValue(); _=try value.append(35,tokenizer:S74ByteTokenizer())
+        value.emitted=Data([0xff])
+        XCTAssertThrowsError(try value.validate(tokenizer:S74ByteTokenizer(),generated:1,vocabulary:258))
+        value=ResumableGuidedTextValue(); value.tokens=[98]; value.emittedTokenCount=0
+        XCTAssertThrowsError(try value.validate(tokenizer:S74ByteTokenizer(),generated:1,vocabulary:258))
+        value=ResumableGuidedTextValue()
+        XCTAssertThrowsError(try value.append(98,tokenizer:NonlinearGuidedTokenizer(huge:true)))
+    }
+}
