+import Foundation
+import XCTest
+@testable import MLXLMCommon
+
+final class ResumableGuidedModelStateTests: XCTestCase {
+    func testSettledLogitsTypedStateAndNewHelperRestore() throws {
+        let setup=try GuidedSetup(rotating:true)
+        let owner=try ResumableGuidedModelState.prepare(model:setup.model,tokens:setup.prompt,identity:setup.identity,
+            options:setup.options.model,cacheSpecs:setup.specs,codecs:guidedCodecs())
+        try owner.consume(35); try owner.consume(229)
+        let saved=try owner.capture(); let document=try saved.document()
+        XCTAssertEqual(document.generatedInputs,2); XCTAssertEqual(document.logits?.shape,[1,1,258])
+        let fresh=GuidedFixtureModel(program:setup.model.program)
+        let restored=try ResumableGuidedModelState.restore(.init(data:saved.data),model:fresh,identity:setup.identity,
+            options:setup.options.model,cacheSpecs:setup.specs,codecs:guidedCodecs())
+        XCTAssertTrue(fresh.inputs.isEmpty)
+        XCTAssertEqual(try restored.capture(),saved)
+        try owner.consume(185); try restored.consume(185)
+        XCTAssertEqual(try restored.capture(),try owner.capture())
+        XCTAssertEqual(saved.data,try ResumableGuidedModelCheckpoint(document:document).data)
+        restored.close(); owner.close()
+    }
+    func testModelCounterRefusalZeroAndComponentBound() throws {
+        let setup=try GuidedSetup()
+        let owner=try ResumableGuidedModelState.prepare(model:setup.model,tokens:setup.prompt,identity:setup.identity,
+            options:setup.options.model,cacheSpecs:setup.specs,codecs:guidedCodecs())
+        var d=try owner.capture().document(); d.generatedInputs+=1
+        let fresh=GuidedFixtureModel(program:setup.model.program)
+        XCTAssertThrowsError(try ResumableGuidedModelState.restore(.init(document:d),model:fresh,identity:setup.identity,
+            options:setup.options.model,cacheSpecs:setup.specs,codecs:guidedCodecs()))
+        XCTAssertTrue(fresh.inputs.isEmpty)
+        XCTAssertThrowsError(try ResumableGuidedModelCheckpoint(data:Data(count:8*1024*1024+1)))
+        owner.close(); XCTAssertThrowsError(try owner.consume(1))
+    }
+}
