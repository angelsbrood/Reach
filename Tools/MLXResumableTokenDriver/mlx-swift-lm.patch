+final class ResumableTokenCacheAllocationTests: XCTestCase {
+    private func checkBoundary(rotating: Bool) throws {
+        try autoreleasepool {
+            let prompt = [1]
+            let identity = try ResumableTokenIdentity(model: "cache-allocation-boundary-v1",
+                configuration: "f32-batch1-heads32-dim256-step256", weights: "analytic-no-weights",
+                input: ResumableTokenIdentity.inputDigest(prompt), backend: "same-native-metal",
+                dependency: "lm:83f3ef6dc5bc24daeea33cfd9e18ab1383bb0bc8")
+            let options = ResumableTokenOptions(vocabularySize: 4, maximumTokens: 2)
+            let specs: [ResumableCacheSpec] = [.init(kind: rotating ? .rotating : .simple,
+                heads: 32, keyDimension: 256, valueDimension: 256,
+                maxSize: rotating ? 257 : 0)]
+            let sourceModel = CacheAllocationBoundaryModel()
+            let source = try ResumableTokenDriver.prepare(model: sourceModel, tokens: prompt,
+                identity: identity, options: options, cacheSpecs: specs)
+            defer { source.close() }
+            let c0 = try source.capture()
+            XCTAssertEqual(sourceModel.physicalSlots, [256])
+            XCTAssertEqual(sourceModel.physicalTensorBytes, [8_388_608])
+            XCTAssertLessThan(c0.data.count, ResumableTokenCheckpoint.maximumBytes)
+            let expected = try checkpointDrain(source)
+            let expectedState = try source.capture()
+            XCTAssertEqual(sourceModel.physicalSlots, [256, 256])
+            let freshModel = CacheAllocationBoundaryModel()
+            let restored = try ResumableTokenDriver.restore(ResumableTokenCheckpoint(data: c0.data),
+                model: freshModel, identity: identity, options: options, cacheSpecs: specs)
+            defer { restored.close() }
+            XCTAssertEqual(freshModel.calls, 0)
+            do {
+                let actual = try checkpointDrain(restored)
+                let actualState = try restored.capture()
+                XCTAssertEqual(actual, expected)
+                XCTAssertEqual(actualState.data, expectedState.data)
+                XCTAssertEqual(freshModel.physicalSlots, [256])
+                XCTAssertEqual(freshModel.physicalTensorBytes, [8_388_608])
+                XCTAssertLessThanOrEqual(Memory.peakMemory, 128 * 1024 * 1024)
+                print("RC1_OBSERVATION cache=\(rotating ? "rotating257" : "simple") source_slots=\(sourceModel.physicalSlots) restored_slots=\(freshModel.physicalSlots) checkpoint_bytes=\(c0.data.count) mlx_peak_bytes=\(Memory.peakMemory)")
+            } catch {
+                print("RC1_REFUSAL cache=\(rotating ? "rotating257" : "simple") source_slots=\(sourceModel.physicalSlots) restored_slots=\(freshModel.physicalSlots) error=\(error)")
+                throw error
+            }
+        }
+        Memory.clearCache()
+    }
+    func testSimpleAllocationBoundaryRestoresCapacityAndSuffix() throws {
+        try checkBoundary(rotating: false)
+    }
+    func testRotatingAllocationBoundaryRestoresCapacityAndSuffix() throws {
+        try checkBoundary(rotating: true)
+    }
+}
