+private final class CacheAllocationBoundaryModel: Module, LanguageModel {
+    var physicalSlots: [Int] = []
+    var physicalTensorBytes: [Int] = []
+    var calls = 0
+    func newCache(parameters: GenerateParameters?) -> [KVCache] { [KVCacheSimple()] }
+    func prepare(_ input: LMInput, cache: [KVCache], state: LMOutput.State?, windowSize: Int?) throws -> PrepareResult {
+        throw ResumableTokenError.unsupported("boundary fixture must not re-prefill")
+    }
+    func callAsFunction(_ input: LMInput.Text, cache: [KVCache]?, state: LMOutput.State?) -> LMOutput {
+        calls += 1
+        let keys = broadcast(input.tokens.asType(.float32).reshaped(1, 1, -1, 1),
+            to: [1, 32, input.tokens.dim(1), 256])
+        let values = keys * 0.5
+        let pair = cache![0].update(keys: keys, values: values)
+        let storage = cache![0].innerState()
+        physicalSlots.append(storage[0].dim(2))
+        physicalTensorBytes.append(storage[0].nbytes)
+        let row = sin(MLXArray.arange(4).asType(.float32) + pair.0.mean() + pair.1.mean())
+        return .init(logits: broadcast(row.reshaped(1, 1, 4), to: [1, input.tokens.dim(1), 4]))
+    }
+}
