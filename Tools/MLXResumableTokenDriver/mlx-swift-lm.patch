+// Additive snapshot access for the opt-in paused driver. Legacy ring updates and the
+// pipelined TokenIterator do not invoke these synchronous value-copy methods.
+extension TokenRing {
+    func captureResumable() -> ResumableRingRecord {
+        .init(buffer: buffer.asArray(Int32.self), count: count, writeIndex: writeIndex)
+    }
+
+    init(resumable record: ResumableRingRecord) {
+        self.init(capacity: record.buffer.count)
+        buffer = MLXArray(record.buffer)
+        count = record.count
+        writeIndex = record.writeIndex
+    }
+}
+
+extension PenaltyProcessor {
+    static func resumable(_ options: ResumableTokenOptions) -> PenaltyProcessor {
+        // Construct exactly the standard ordered composition, including disabled zeros.
+        .init(
+            repetitionContext: options.repetitionPenalty.flatMap {
+                $0 == 0 ? nil : RepetitionContext(repetitionPenalty: $0,
+                    repetitionContextSize: options.repetitionContextSize)
+            },
+            presenceContext: options.presencePenalty.flatMap {
+                $0 == 0 ? nil : PresencePenaltyContext(presencePenalty: $0,
+                    presenceContextSize: options.presenceContextSize)
+            },
+            frequencyContext: options.frequencyPenalty.flatMap {
+                $0 == 0 ? nil : FrequencyPenaltyContext(frequencyPenalty: $0,
+                    frequencyContextSize: options.frequencyContextSize)
+            })
+    }
+
+    func captureResumable() -> [ResumableRingRecord?] {
+        [repetitionContext?.ring.captureResumable(), presenceContext?.ring.captureResumable(),
+         frequencyContext?.ring.captureResumable()]
+    }
+
+    static func validateResumable(_ records: [ResumableRingRecord?],
+                                  options: ResumableTokenOptions) throws {
+        guard records.count == 3 else { throw ResumableTokenError.invalid("processor composition") }
+        let strengths = [options.repetitionPenalty, options.presencePenalty, options.frequencyPenalty]
+        let capacities = [options.repetitionContextSize, options.presenceContextSize, options.frequencyContextSize]
+        for i in 0..<3 {
+            let enabled = strengths[i].map { $0 != 0 } ?? false
+            guard enabled == (records[i] != nil) else { throw ResumableTokenError.incompatible }
+            try records[i]?.validate(capacity: capacities[i], vocabulary: options.vocabularySize)
+        }
+    }
+
+    static func restoredResumable(_ records: [ResumableRingRecord?],
+                                  options: ResumableTokenOptions) throws -> PenaltyProcessor {
+        try validateResumable(records, options: options)
+        var processor = resumable(options)
+        if let record = records[0] { processor.repetitionContext?.ring = TokenRing(resumable: record) }
+        if let record = records[1] { processor.presenceContext?.ring = TokenRing(resumable: record) }
+        if let record = records[2] { processor.frequencyContext?.ring = TokenRing(resumable: record) }
+        return processor
+    }
+}
