+final class ResumableTokenCheckpointTests: XCTestCase {
+    func testCorruptTruncatedOversizedAndIncompatibleRefusalsDoNotMutate() throws {
+        let model = CheckpointTestModel()
+        let driver = try checkpointPrepare(model, options: checkpointOptions(stochastic: true), rotating: true)
+        _ = try driver.advance()
+        let original = try driver.capture()
+        let calls = model.calls
+        func refused(_ checkpoint: ResumableTokenCheckpoint) {
+            XCTAssertThrowsError(try ResumableTokenDriver.restore(checkpoint, model: model,
+                identity: checkpointIdentity(), options: checkpointOptions(stochastic: true),
+                cacheSpecs: checkpointSpecs(rotating: true), codecs: checkpointTestCodecs()))
+            XCTAssertEqual(model.calls, calls)
+            XCTAssertEqual(try driver.capture().data, original.data)
+        }
+        var corrupt = original.data; corrupt[corrupt.startIndex] ^= 1
+        XCTAssertThrowsError(try ResumableTokenCheckpoint(data: corrupt))
+        XCTAssertThrowsError(try ResumableTokenCheckpoint(data: original.data.dropLast()))
+        XCTAssertThrowsError(try ResumableTokenCheckpoint(data: Data(repeating: 0, count: ResumableTokenCheckpoint.maximumBytes + 1)))
+        let mutations: [(inout ResumableDocument) -> Void] = [
+            { $0.version = 3 }, { $0.options.sampler = "custom-unknown" },
+            { $0.options.seed += 1 }, { $0.tokenCount = -1 }, { $0.pending = 99 },
+            { $0.exhausted = true }, { $0.randomDraws = 0 }, { $0.randomKey = nil },
+            { $0.rings = [] }, { $0.state = ($0.state ?? []) + ($0.state ?? []) },
+            { $0.codecs = [] }, { $0.cacheSpecs = [] },
+        ]
+        for mutation in mutations {
+            var d = try original.document(); mutation(&d)
+            let c = try ResumableTokenCheckpoint(document: d)
+            if d.version == 3 { XCTAssertThrowsError(try c.document()) }
+            else { refused(c) }
+        }
+        var previousSchema = try original.document()
+        previousSchema.version = 1
+        let oldData = try ResumableTokenCheckpoint(document: previousSchema).data
+        XCTAssertThrowsError(try ResumableTokenCheckpoint(data: oldData)) {
+            XCTAssertEqual($0 as? ResumableTokenError, .incompatible)
+        }
+        // Tampered payloads below have recomputed checksums: validate before invoking
+        // legacy array/cache setters, not merely relying on the integrity envelope.
+        let replacements: [(String, Any)] = [
+            ("allocationLength", 0), ("allocationLength", Int.max),
+            ("offset", -1), ("metadata", ["1", "4", "256", "6", "999"]),
+            ("tensors", []),
+        ]
+        for (field, value) in replacements {
+            var object = try JSONSerialization.jsonObject(with: ResumableTokenCheckpoint.encoder().encode(original.document())) as! [String: Any]
+            var caches = object["caches"] as! [[String: Any]]
+            caches[0][field] = value; object["caches"] = caches
+            let d = try JSONDecoder().decode(ResumableDocument.self, from: JSONSerialization.data(withJSONObject: object))
+            refused(try .init(document: d))
+        }
+        for (field, value) in [("shape", [1, 1, -1, 4] as Any), ("dtype", "complex64" as Any), ("bytes", "AA==" as Any)] {
+            var object = try JSONSerialization.jsonObject(with: ResumableTokenCheckpoint.encoder().encode(original.document())) as! [String: Any]
+            var caches = object["caches"] as! [[String: Any]]
+            var tensors = caches[0]["tensors"] as! [[String: Any]]
+            tensors[0][field] = value; caches[0]["tensors"] = tensors; object["caches"] = caches
+            let d = try JSONDecoder().decode(ResumableDocument.self, from: JSONSerialization.data(withJSONObject: object))
+            refused(try .init(document: d))
+        }
+        for field in ["model", "configuration", "weights", "input", "backend", "dependency"] {
+            var object = try JSONSerialization.jsonObject(with: ResumableTokenCheckpoint.encoder().encode(original.document())) as! [String: Any]
+            var identity = object["identity"] as! [String: Any]; identity[field] = "changed"
+            object["identity"] = identity
+            let d = try JSONDecoder().decode(ResumableDocument.self, from: JSONSerialization.data(withJSONObject: object))
+            refused(try .init(document: d))
+        }
+        driver.close()
+    }
