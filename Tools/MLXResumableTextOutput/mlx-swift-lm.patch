+        XCTAssertThrowsError(try ResumableTextCheckpoint(data: damaged))
+        XCTAssertThrowsError(try ResumableTextCheckpoint(data: checkpoint.document().raw))
+        XCTAssertThrowsError(try ResumableTextCheckpoint(data: Data(count: ResumableTextCheckpoint.maximumBytes + 1)))
