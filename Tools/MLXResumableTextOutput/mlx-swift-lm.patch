+        huge.output.segment = Data(repeating: 97, count: 200_000)
+        XCTAssertThrowsError(try ResumableTextCheckpoint(document: huge))
+        huge = try checkpoint.document(); huge.raw = Data(count: ResumableTokenCheckpoint.maximumBytes + 1)
+        XCTAssertThrowsError(try ResumableTextCheckpoint(document: huge))
