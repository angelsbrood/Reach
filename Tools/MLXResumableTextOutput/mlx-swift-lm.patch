+final class ResumableTextCheckpointTests: XCTestCase {
+    func testIncompatibleOptionsAndRawBindingLeaveExistingDriverUntouched() throws {
+        let setup = try TextTestSetup([1,11,12,6,7,8], stops: ["<stop>"])
+        let driver = try setup.prepare(); _ = try driver.advance(); _ = try driver.advance()
+        let saved = try driver.capture(); let calls = setup.model.calls
+        for options in [
+            try ResumableTextOptions(tokenizerIdentity: "changed", stopTokenIDs: [30], unknownTokenID: 31, stopStrings: ["<stop>"]),
+            try ResumableTextOptions(tokenizerIdentity: "s73-byte-fixture-v1", stopTokenIDs: [30], unknownTokenID: 31, stopStrings: ["changed"]),
+            try ResumableTextOptions(tokenizerIdentity: "s73-byte-fixture-v1", stopTokenIDs: [29], unknownTokenID: 31, stopStrings: ["<stop>"]),
+        ] { XCTAssertThrowsError(try setup.restore(saved, options: options)) }
+        var document = try saved.document()
+        let different = try setup.prepare(); document.raw = try different.capture().document().raw
+        XCTAssertThrowsError(try setup.restore(.init(document: document)))
+        XCTAssertEqual(setup.model.calls, calls + 1) // only explicit different.prepare
+        XCTAssertEqual(try driver.capture(), saved)
+        let fresh = TextScriptModel([1,11,12,6,7,8])
+        let restored = try setup.restore(saved, model: fresh)
+        XCTAssertEqual(fresh.calls, 0)
+        XCTAssertEqual(try textDrain(restored), try textDrain(driver))
+        restored.close(); different.close(); driver.close()
+    }
+
+    func testMalformedCounterLifecycleAndSegmentRefusals() throws {
+        let setup = try TextTestSetup([1,11,12,6,7,8], stops: ["<stop>"])
+        let driver = try setup.prepare(); _ = try driver.advance(); _ = try driver.advance()
+        let checkpoint = try driver.capture(); let document = try checkpoint.document()
+        let changes: [(inout ResumableTextDocument) -> Void] = [
+            { $0.output.rawCount += 1 }, { $0.output.generationCount += 1 },
+            { $0.output.promptCount += 1 }, { $0.output.terminal = .stop },
+            { $0.output.terminal = .length }, { $0.output.stopped = true },
+            { $0.output.lastToken = 30 }, { $0.output.segmentTokens = [99] },
+            { $0.output.segment = Data("wrong".utf8) }, { $0.output.segment = Data([0xff]) },
+            { $0.output.emittedTokenCount = Int.max }, { $0.output.buffer = Data("leak".utf8) },
+            { $0.output.rawDigest = "wrong" },
+        ]
+        for change in changes {
+            var altered = document; change(&altered)
+            let fresh = TextScriptModel([1,11,12,6,7,8])
+            XCTAssertThrowsError(try setup.restore(.init(document: altered), model: fresh))
+            XCTAssertEqual(fresh.calls, 0)
+            XCTAssertEqual(try driver.capture(), checkpoint)
+        }
+        driver.close()
+    }
+
+    func testSchemaCorruptionTruncationRawOnlyAndEncodedBounds() throws {
+        let setup = try TextTestSetup([1,2]); let driver = try setup.prepare()
+        let checkpoint = try driver.capture()
+        for mutate in [
+            { (d: inout ResumableTextDocument) in d.version = 2 },
+            { (d: inout ResumableTextDocument) in d.rawSchema = 1 },
+            { (d: inout ResumableTextDocument) in d.rawCandidate = "other" },
+        ] {
+            var d = try checkpoint.document(); mutate(&d)
+            XCTAssertThrowsError(try ResumableTextCheckpoint(data: ResumableTextCheckpoint(document: d).data)) {
+                XCTAssertEqual($0 as? ResumableTokenError, .incompatible)
+            }
