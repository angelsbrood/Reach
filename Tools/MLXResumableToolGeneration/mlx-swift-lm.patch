+        let cancel = try XCTUnwrap(live.cancel())
+        XCTAssertEqual(s.model.calls, calls)
+        XCTAssertEqual(try cancel.checkpoint.document().parser, try saved.document().parser)
+        live.close(); live.close()
+        XCTAssertThrowsError(try live.capture()); XCTAssertThrowsError(try live.advance()); XCTAssertThrowsError(try live.cancel())
+        let fresh = try TGSetup(s.item), earlier = try fresh.restore(saved)
+        XCTAssertEqual(fresh.model.calls, 0); XCTAssertNotNil(try earlier.advance()); earlier.close()
+    }
+
+    func testOversizedForwardAndPostAdvanceFaultAreAtomic() throws {
+        var huge = try tgFixture("length-flush")
