+final class ResumableToolGenerationTests: XCTestCase {
+    func verifyCuts(_ item: TGFixture) throws {
+        let reference = try tgReference(item)
+        try tgExplicit(reference.0, item: item)
+        let original = try TGSetup(item), live = try original.prepare()
+        defer { live.close() }
+        var snapshots = [try live.capture()], rows: [TGObserved] = []
+        while let batch = try tgStep(live, item: item) {
+            rows.append(.init(token: batch.token, records: batch.records)); snapshots.append(batch.checkpoint)
+        }
+        try tgExplicit(rows, item: item)
+        XCTAssertEqual(try encoder().encode(rows), try encoder().encode(reference.0))
+        let final = try live.capture(), d = try final.document()
+        try tgCompareText(d.text, reference.1)
+        XCTAssertEqual(d.parser, reference.2)
+        for cut in snapshots.indices {
+            let fresh = try TGSetup(item), resumed = try fresh.restore(snapshots[cut])
+            defer { resumed.close() }
+            XCTAssertEqual(fresh.model.calls, 0); XCTAssertEqual(fresh.model.prepares, 0)
+            XCTAssertEqual(try resumed.capture(), snapshots[cut])
+            let suffix = try tgDrain(resumed, item: item)
+            XCTAssertEqual(try encoder().encode(suffix), try encoder().encode(Array(rows.dropFirst(cut))), "\(item.name) cut \(cut)")
+            try tgCompare(resumed.capture(), final)
+            let calls = fresh.model.calls, terminal = try resumed.capture()
+            XCTAssertNil(try resumed.advance()); XCTAssertNil(try resumed.cancel())
+            XCTAssertEqual(fresh.model.calls, calls); XCTAssertEqual(try resumed.capture(), terminal)
+        }
+        XCTAssertEqual(original.model.prepares, 0)
+    }
+
+    func testGeneratedJSONAtEveryCutAndBothCacheKinds() throws {
+        var item = try tgFixture("json")
+        try verifyCuts(item)
+        item.rotating = false; item.stochastic = false
+        try verifyCuts(item)
+    }
+    func testSchemaEOSFlushAndZeroAtEveryCut() throws {
+        for name in ["xml","mistral","length-flush","zero"] { try verifyCuts(tgFixture(name)) }
+    }
+    func testCancellationAtEveryCutAndFrozenTerminal() throws {
+        let item = try tgFixture("cancel")
+        try verifyCuts(item)
+        let s = try TGSetup(item), live = try s.prepare()
+        defer { live.close() }
+        for _ in 0..<3 { _ = try live.advance() }
+        let before = try live.capture().document()
+        let textBefore = try ResumableTextCheckpoint(data: before.text).document()
+        let parserBefore = try ResumableToolCallCheckpoint(data: before.parser).document()
+        XCTAssertEqual(textBefore.output.buffer, Data("<stop".utf8))
+        XCTAssertEqual(parserBefore.parser.state, "collectingToolCall")
+        XCTAssertFalse(parserBefore.finished)
+        let calls = s.model.calls, batch = try XCTUnwrap(live.cancel())
+        let after = try batch.checkpoint.document()
+        XCTAssertEqual(after.disposition, .cancelledFrozen)
+        XCTAssertEqual(after.parser, before.parser)
+        XCTAssertEqual(try ResumableTextCheckpoint(data: after.text).document().raw, textBefore.raw)
+        XCTAssertEqual(batch.records.count, 1); XCTAssertEqual(s.model.calls, calls)
+        XCTAssertTrue(try ResumableTextCheckpoint(data: after.text).document().output.buffer.isEmpty)
+    }
+    func testTinyLlamaCompositionAtEveryCut() throws { try verifyCuts(tgFixture("llama")) }
+
+    func testNoWorkTransitionsConfigurationAndClose() throws {
+        let zero = try TGSetup(tgFixture("zero")), z = try zero.prepare()
+        defer { z.close() }
+        XCTAssertEqual(zero.model.calls, 0)
