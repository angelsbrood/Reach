+func sgCuts(_ snapshots:[ResumableGuidedCheckpoint],item:SGFixture) throws -> [Int] {
+    var cuts:Set<Int>=[0,1,min(10,snapshots.count-1),snapshots.count-1]
+    if let r=item.expected.range(of:"\"arguments\":") {
+        let offset=item.expected[..<r.upperBound].utf8.count
