+                XCTAssertEqual(visible,Data("AbetweenZ".utf8))
+            }
+        }
+    }
+    func testSuppliedDuplicateMissingEmptyAndCollisionIDsAcrossRestore() throws {
+        for format in [ToolCallFormat.json,.mistral] {
+            let config=try ResumableToolCallConfiguration(format:format)
+            let live=try ResumableToolCallProcessor.prepare(configuration:config,namespace:toolFixtureNamespace)
+            let allocation=ToolCallIDSequence(namespace:toolFixtureNamespace)
+            let collision=allocation.candidate(format:format,at:0)
+            func chunk(_ id:String?) -> String {
+                if format == .mistral { return "[TOOL_CALLS]f"+(id.map { "[CALL_ID]"+$0 } ?? "")+"[ARGS]{}" }
+                return "<tool_call>{"+(id.map { "\"id\":\""+$0+"\"," } ?? "")+"\"name\":\"f\",\"arguments\":{}}</tool_call>"
+            }
+            // Mistral allocates at EOS, so put all supplied/duplicate cases in
+            // one buffered stream; JSON additionally pauses after the collision.
+            let chunks=[chunk(collision),chunk(nil),chunk(""),chunk("keep"),chunk("keep")]
+            var output:[ResumableToolCallRecord]=[]
+            output+=try live.consume(chunks[0]).records
+            let saved=try live.capture()
+            let resumed=try ResumableToolCallProcessor.restore(saved,configuration:config,namespace:toolFixtureNamespace)
+            var suffix:[ResumableToolCallRecord]=[], restored:[ResumableToolCallRecord]=[]
+            for chunk in chunks.dropFirst() { suffix+=try live.consume(chunk).records; restored+=try resumed.consume(chunk).records }
+            suffix+=try XCTUnwrap(live.finish()).records; restored+=try XCTUnwrap(resumed.finish()).records
+            XCTAssertEqual(try toolRecordBytes(suffix),try toolRecordBytes(restored)); output+=suffix
+            XCTAssertEqual(toolCalls(output).compactMap(\.id),[collision,allocation.candidate(format:format,at:1),allocation.candidate(format:format,at:2),"keep",allocation.candidate(format:format,at:3)])
+            let final=try live.capture().document(); XCTAssertEqual(final.parser.allocation.position,4)
+            live.close(); resumed.close()
+        }
+    }
+    func testLegacyRandomIDsAndFreshNamespacesRemainOptIn() throws {
+        let config=try ResumableToolCallConfiguration(format:.json)
+        let a=try ResumableToolCallProcessor.prepare(configuration:config), b=try ResumableToolCallProcessor.prepare(configuration:config)
+        XCTAssertNotEqual(a.namespace,b.namespace); XCTAssertEqual(try a.capture().document().parser.allocation.namespace,a.namespace)
+        let text=#"<tool_call>{"name":"f","arguments":{}}</tool_call>"#
