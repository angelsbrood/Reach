+// END SHARED FIXTURES
+
+func toolRecordBytes(_ records:[ResumableToolCallRecord]) throws -> Data { try ToolCheckpointEncoding.encode(records) }
+func toolCalls(_ records:[ResumableToolCallRecord]) -> [ToolCall] {
+    records.compactMap { if case .toolCall(let call)=$0 { return call }; return nil }
+}
+func toolLegacy(_ output:[ToolCallProcessor.Output]) -> [ResumableToolCallRecord] {
+    output.map { switch $0 { case .response(let value): return .response(Data(value.utf8)); case .toolCall(let call): return .toolCall(call) } }
+}
+func toolComparable(_ records:[ResumableToolCallRecord], fixture:ToolParsingFixture) throws -> Data {
+    try toolRecordBytes(records.map {
+        guard case .toolCall(let call)=$0 else { return $0 }
+        let id=call.id!
+        if fixture.supplied.contains(id) { return $0 }
+        let pattern=fixture.format == .mistral ? "^[A-Za-z0-9]{9}$" : "^call_[a-f0-9]{32}$"
+        XCTAssertNotNil(id.range(of:pattern,options:.regularExpression))
+        return .toolCall(.init(function:call.function,id:"generated"))
+    })
+}
+func toolExercise(_ fixture:ToolParsingFixture) throws -> [ResumableToolCallRecord] {
+    let config=try fixture.configuration()
+    let live=try ResumableToolCallProcessor.prepare(configuration:config,namespace:toolFixtureNamespace)
+    var checkpoints=[try live.capture()], batches:[[ResumableToolCallRecord]]=[]
+    let legacy=ToolCallProcessor(format:fixture.format,tools:try config.validatedTools())
+    for chunk in fixture.chunks {
+        let batch=try live.consume(chunk); batches.append(batch.records); checkpoints.append(batch.checkpoint)
+        XCTAssertEqual(try toolComparable(batch.records,fixture:fixture),try toolComparable(toolLegacy(legacy.processChunkOutputs(chunk)),fixture:fixture),fixture.name)
+    }
+    let end=try XCTUnwrap(live.finish()); batches.append(end.records); checkpoints.append(end.checkpoint)
+    XCTAssertEqual(try toolComparable(end.records,fixture:fixture),try toolComparable(toolLegacy(legacy.processEOSOutputs()),fixture:fixture),fixture.name)
+    let all=batches.flatMap { $0 }
+    XCTAssertEqual(toolCalls(all).map(\.function.name),fixture.names,fixture.name)
+    XCTAssertEqual(Set(toolCalls(all).compactMap(\.id)).count,fixture.names.count)
+    for cut in 0..<checkpoints.count {
+        let saved=checkpoints[cut]; let bytes=saved.data
+        let resumed=try ResumableToolCallProcessor.restore(saved,configuration:config,namespace:toolFixtureNamespace)
+        XCTAssertEqual(try resumed.capture(),saved)
+        var suffix:[[ResumableToolCallRecord]]=[]
+        for chunk in fixture.chunks.dropFirst(min(cut,fixture.chunks.count)) { suffix.append(try resumed.consume(chunk).records) }
+        if let end=try resumed.finish() { suffix.append(end.records) }
+        XCTAssertEqual(try ToolCheckpointEncoding.encode(suffix),try ToolCheckpointEncoding.encode(Array(batches.dropFirst(cut))),"\(fixture.name) cut \(cut)")
+        XCTAssertEqual(try resumed.capture(),try live.capture()); XCTAssertEqual(saved.data,bytes)
+        XCTAssertNil(try resumed.finish()); XCTAssertThrowsError(try resumed.consume("late"))
+        resumed.close()
+    }
+    live.close(); return all
+}
+
+final class ResumableToolCallProcessorTests: XCTestCase {
+    func testAllTenFormatsAtEveryDeclaredCutWithLegacyParity() throws {
+        let fixtures=toolSmokeFixtures(); XCTAssertEqual(Set(fixtures.map(\.format)),Set(ToolCallFormat.allCases))
+        for fixture in fixtures {
+            let records=try toolExercise(fixture)
+            XCTAssertEqual(toolCalls(records).first?.function.arguments["x"],.string("中"))
+        }
+    }
+    func testDeepJSONSchemaInlineEOSAndInvalidCuts() throws {
+        for fixture in toolDeepFixtures() {
